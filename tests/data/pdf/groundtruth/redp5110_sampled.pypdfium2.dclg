    <location value="350"/>
    <location value="237"/>
    <location value="356"/>
    -Current state of IBM i security
    <ldiv/>
    <location value="114"/>
    <location value="358"/>
    <location value="221"/>
    <location value="364"/>
    -DB2 for i security controls
  </list>
