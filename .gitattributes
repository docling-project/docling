# Normalize line endings for all text files
* text=auto

# Python source files - always use LF
*.py text eol=lf

# Jupyter notebooks - always use LF
*.ipynb text eol=lf

# Configuration files - always use LF
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Shell scripts - always use LF
*.sh text eol=lf

# Linguist overrides
tests/data/** linguist-vendored
tests/data_scanned/** linguist-vendored
docs/** linguist-vendored
# Test inputs: keep the committed bytes (some CSV/XML sources are CRLF on purpose)
tests/data/** -text
# Generated ground truth: LF in the repo and in every checkout
tests/data/**/groundtruth/** text eol=lf
